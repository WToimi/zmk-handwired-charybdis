&pinctrl {
    uart0_default: uart0_default {
            group1 {
                psels = <NRF_PSEL(UART_TX, 0, 6)>, // EXT1
                        <NRF_PSEL(UART_RX, 0, 8)>; // EXT2
            };
        };


    spi0_default: spi0_default {
        pwm3360_group0{
            psels = <NRF_PSEL(SPIM_SCK, 2, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>,
        }
        pwm3360_group1{
            psels = <NRF_PSEL(SPIM_MISO, 2, 0)>;
            input-enable;
        }
    }

};
