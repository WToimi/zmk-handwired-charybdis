#include <dt-bindings/zmk/matrix_transform.h>
#include <charybdis_left_pinctrl.dtsi>
#include <charybdis_right_pinctrl.dtsi>

/ {
    wired_split{
        compatible = "zmk,wired-split";
        device = <&pro_micro_serial>;
    }

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
	    ;

            chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &charybdis_physical_layout;
        // Other chosen items
    };

&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
	mouse: mouse@0 {
		compatible = "pixart,pmw3360";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <2000000>;

		// pmw3360 driver parameters
		irq-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		cpi = <600>;
		rotate-90;
	};
};

mouse_listener {
		compatible = "zmk,input-listener";
		device = <&mouse>;
	};


    };
        default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
        //  LKey 1 |LKey 2 |LKey 3 LKey 4 |LKey 5 |LKey 6           RKey 1 |RKey 2 |RKey 3 RKey 4 |RKey 5 |RKey 6
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        //  LKey 7 |LKey 8 |LKey 9 LKey 10 |LKey 11 |LKey 12        RKey 7 |RKey 8 |RKey 9 RKey 10 |RKey 11 |RKey 12
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        //  LKey 13 |LKey 14 |LKey 15 LKey 16 |LKey 17 |LKey 18     RKey 13 |RKey 14 |RKey 15 RKey 16 |RKey 17 |RKey 18
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)         RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        //  LKey 19 |LKey 20 |LKey 21 LKey 22 |LKey 23 |LKey 24     RKey 19 |RKey 20 |RKey 21 RKey 22 |RKey 23 |RKey 24
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        //                          LKey 25 |LKey 26 |LKey 27       RKey 25 |RKey 26
                                    RC(4,0) RC(4,1) RC(4,2)         RC(4,3) RC(4,4)
        //                                  LKey 28 |LKey 29        RKey 1
                                            RC(5,0) RC(5,1)         RC(5,3)
        >;
    };

};
